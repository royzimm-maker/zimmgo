# Claude / Anthropic — required, the app won't run without this
# Next.js only reads .env.local at server startup — if you edit this key (or
# any other value here) while `npm run dev` is already running, restart it.
# Otherwise the running process keeps using whatever it loaded at boot, and
# API calls fail with a 401 authentication_error even though the file on
# disk — and the key in the Anthropic console — are both fine.
ANTHROPIC_API_KEY=sk-ant-...

# ────────────────────────────────────────────────────────────────
# Nothing below is wired up yet. All flight/hotel/activity/restaurant
# data is deterministic mock data — see the "PRODUCTION SWAP POINT"
# comments in lib/api/*.ts and lib/data/*.ts for exactly where each
# of these would plug in. Add real values here only once that
# integration is actually built, not before.
# ────────────────────────────────────────────────────────────────

# Amadeus (Flights) — https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Booking.com (Hotels) — https://developers.booking.com
BOOKING_API_KEY=

# GetYourGuide (Activities) — https://partner.getyourguide.com
GYG_API_KEY=

# Database — prisma/schema.prisma defines a full schema, but no code in
# the app actually uses @prisma/client yet. Every trip today is stored
# only in the browser's localStorage.
DATABASE_URL=postgresql://user:password@localhost:5432/travel_agent
