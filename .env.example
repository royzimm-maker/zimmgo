# Optional. Set this to gate the whole site behind a single shared
# password — a private-beta / "friends and family" gate, not real
# per-user accounts. Unset (the default) means the site is fully open;
# see middleware.ts. Anyone who knows the password stays in for ~90 days
# via a cookie, so there's no need to log in again on every visit.
SITE_PASSWORD=

# Claude / Anthropic — required, the app won't run without this
# Next.js only reads .env.local at server startup — if you edit this key (or
# any other value here) while `npm run dev` is already running, restart it.
# Otherwise the running process keeps using whatever it loaded at boot, and
# API calls fail with a 401 authentication_error even though the file on
# disk — and the key in the Anthropic console — are both fine.
ANTHROPIC_API_KEY=sk-ant-...

# ────────────────────────────────────────────────────────────────
# Nothing below except DATABASE_URL is wired up yet. All flight/hotel/
# activity/restaurant data is deterministic mock data — see the
# "PRODUCTION SWAP POINT" comments in lib/api/*.ts and lib/data/*.ts for
# exactly where each of these would plug in. Add real values here only
# once that integration is actually built, not before.
# ────────────────────────────────────────────────────────────────

# Amadeus (Flights) — https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Booking.com (Hotels) — https://developers.booking.com
BOOKING_API_KEY=

# GetYourGuide (Activities) — https://partner.getyourguide.com
GYG_API_KEY=

# Database — live. Backs anonymous, device-linked trip persistence
# (app/api/trip-sync/route.ts) so a trip survives a cleared browser cache.
# prisma/schema.prisma defines a single Device table (id + a JSON blob
# mirroring what tripStore.ts already persists to localStorage) — no user
# accounts, no per-field columns to keep in sync with types/trip.ts.
# On Neon specifically, use the pooled connection string (the one with
# "-pooler" in the hostname) — Vercel's serverless functions don't hold a
# persistent connection well against the unpooled one.
DATABASE_URL=postgresql://user:password@localhost:5432/travel_agent

# Optional. Set this to any random secret string to enable
# GET /api/admin/usage-summary (real Anthropic token usage + estimated cost,
# aggregated by route — see lib/ai/usageLog.ts). That route refuses every
# request until this is set, so it's safe to leave unset.
ADMIN_TOKEN=
