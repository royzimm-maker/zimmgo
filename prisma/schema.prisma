// Prisma schema — run `npx prisma db push` to sync to your Postgres database
// See: https://pris.ly/d/prisma-schema
//
// Deliberately a single JSON-mirror table, not a normalized relational
// schema: every trip's data model (types/trip.ts) is already fully JSON and
// changes shape often, so this table just durably mirrors the exact blob
// tripStore.ts already persists to localStorage, keyed by an anonymous
// per-device cookie (see app/api/trip-sync/route.ts). No user accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id        String   @id
  data      Json
  // Optimistic-concurrency counter — a PUT only applies if the client's
  // baseVersion still matches, so a stale tab can't blindly overwrite a
  // newer save (see app/api/trip-sync/route.ts).
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fixed-window request counters shared by every serverless instance — an
// in-memory Map would give each instance its own count (see lib/rateLimit.ts).
model RateLimitWindow {
  key         String   // "<bucket>:<client ip>"
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Long AI work (itinerary generation, auto-plan) runs as a background job
// the client polls, so a dropped connection or page refresh resumes the same
// run instead of paying for a new one (see lib/jobs/backgroundJobs.ts).
// The table keeps its original name, so no database change is needed.
model BackgroundJob {
  id         String   @id @default(cuid())
  requestKey String   @unique // client-generated id for this run, namespaced by job kind
  status     String   // "running" | "done" | "error"
  stage      String?  // human-readable progress label
  result     Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@map("GenerationJob")
}

// One row per Anthropic API call, across every route that calls
// client.messages.create (see lib/ai/usageLog.ts). Exists to turn cost
// estimates into real measured numbers — see app/api/admin/usage-summary
// for the aggregated view.
model ApiUsageEvent {
  id               String   @id @default(cuid())
  route            String   // rateLimit's own `bucket` name, e.g. "itinerary-generate"
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([route])
  @@index([createdAt])
}
