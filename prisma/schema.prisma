// Prisma schema — run `npx prisma db push` to sync to your Postgres database
// See: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]
}

model Trip {
  id           String       @id @default(cuid())
  userId       String?
  name         String       @default("My Trip")
  currentStep  String       @default("destination")
  preferences  Json         // Serialised TripPreferences
  completedSteps String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id])
  itineraries  Itinerary[]

  @@index([userId])
}

model Itinerary {
  id                  String   @id @default(cuid())
  tripId              String
  version             Int      @default(1)
  days                Json     // Serialised ItineraryDay[]
  flights             Json     // Serialised FlightOption[]
  hotels              Json     // Serialised HotelOption[]
  activities          Json     // Serialised ActivityOption[]
  totalEstimatedCost  Float
  currency            String   @default("USD")
  aiSummary           String
  whyThisWorks        String
  createdAt           DateTime @default(now())
  trip                Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  tripId      String
  role        String   // "user" | "assistant"
  content     String
  stepContext String?
  createdAt   DateTime @default(now())

  @@index([tripId])
}
